          "cachedResultName": "health_raw"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "received_at",
              "condition": "gt",
              "keyValue": "={{ $json.value ? $json.value : '1970-01-01T00:00:00.000Z' }}"
            },
            {
              "keyName": "received_at",
              "condition": "lte",
              "keyValue": "={{ $now.minus({ minutes: 2 }).toUTC().toFormat(\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\") }}"
            }
          ]
        },
        "returnAll": true,
        "orderBy": true,
        "orderByColumn": "received_at",
        "orderByDirection": "ASC"
