    {
      "parameters": {
        "jsCode": "// Runs once for all items. Input: health_raw rows (received_at > watermark, older than 2 minutes).\n// With no new rows the read node outputs one empty item; it is ignored below.\n// Watermark comparison uses a fixed-width UTC stamp so DST offsets cannot reorder rows.\n// Output: items tagged record_type = 'point' | 'workout' | 'watermark' | 'unlock'.\n// 'unlock' is always the last item, so the lock is released after every other write.\nconst ZONE = $now.zoneName; // workflow timezone (Settings > Timezone)\nconst nowLocal = DateTime.now().setZone(ZONE).toFormat(\"yyyy-MM-dd'T'HH:mm:ss.SSSZZ\");\n\nfunction parseTs(s) {\n  if (s === undefined || s === null || s === '') return null;\n  let d = DateTime.fromFormat(String(s), 'yyyy-MM-dd HH:mm:ss ZZZ', { setZone: true });\n  if (!d.isValid) d = DateTime.fromISO(String(s), { setZone: true });\n  return d.isValid ? d : null;\n}\nfunction num(v) {\n  if (v === undefined || v === null || v === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n}\nfunction qtyOf(o) { return o && typeof o === 'object' ? num(o.qty) : num(o); }\nfunction unitsOf(o) { return o && typeof o === 'object' ? String(o.units || '') : ''; }\nfunction toKcal(o) {\n  const q = qtyOf(o); if (q === null) return null;\n  const u = unitsOf(o).toLowerCase();\n  if (u === 'kj') return Math.round((q / 4.184) * 10) / 10;\n  return Math.round(q * 10) / 10;\n}\nfunction toKm(o) {\n  const q = qtyOf(o); if (q === null) return null;\n  const u = unitsOf(o).toLowerCase();\n  const k = u === 'm' ? q / 1000 : (u === 'mi' ? q * 1.609344 : q);\n  return Math.round(k * 1000) / 1000;\n}\nfunction sourceStr(s) {\n  if (s === undefined || s === null) return '';\n  if (typeof s === 'object') return String(s.name || s.identifier || '');\n  return String(s);\n}\n\nconst readRows = $input.all().map(i => i.json).filter(r => r && typeof r === 'object' && Object.keys(r).length > 0);\n// Watermark uses every read row, including ones later skipped, so a row with no\n// payload_id or body is not selected again on the next run.\nconst UTC_STAMP = \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\";\nfunction utcStamp(s) {\n  const d = DateTime.fromISO(String(s || ''), { setZone: true });\n  return d.isValid ? d.toUTC().toFormat(UTC_STAMP) : '';\n}\nlet maxReceived = '';\nfor (const r of readRows) {\n  const stamp = utcStamp(r.received_at);\n  if (stamp && stamp > maxReceived) maxReceived = stamp;\n}\nconst errors = [];\nlet skipped = 0;\nconst rows = [];\nfor (const r of readRows) {\n  if (r.payload_id && r.body) rows.push(r);\n  else skipped += 1;\n}\nif (skipped) errors.push('skipped=' + skipped + ' missing payload_id or body');\nrows.sort((a, b) => {\n  const as = utcStamp(a.received_at) || String(a.received_at || '');\n  const bs = utcStamp(b.received_at) || String(b.received_at || '');\n  if (as !== bs) return as < bs ? -1 : 1;\n  return Number(a.id || 0) - Number(b.id || 0);\n});\n\nconst points = new Map();\nconst workouts = new Map();\n\nfor (const r of rows) {\n  let body;\n  try { body = JSON.parse(r.body); } catch (e) { errors.push(r.payload_id + ': bad JSON'); continue; }\n  const data = (body && body.data) || {};\n\n  for (const m of (Array.isArray(data.metrics) ? data.metrics : [])) {\n    const metric = String((m && m.name) || '');\n    if (!metric) continue;\n    for (const p of (Array.isArray(m.data) ? m.data : [])) {\n      const d = parseTs(p && p.date);\n      if (!d) { errors.push(r.payload_id + ': bad date in ' + metric); continue; }\n      const ts = d.toUTC().toISO();\n      const source = sourceStr(p.source);\n      const key = metric + '|' + ts;\n      const extra = {};\n      for (const k of Object.keys(p)) {\n        if (k !== 'date' && k !== 'qty' && k !== 'source' && k !== 'units') extra[k] = p[k];\n      }\n      let qty = num(p.qty);\n      if (qty === null && p.Avg !== undefined) qty = num(p.Avg);\n      if (qty === null && p.totalSleep !== undefined) qty = num(p.totalSleep);\n      if (qty === null && p.asleep !== undefined) qty = num(p.asleep);\n      points.set(key, {\n        record_type: 'point',\n        key, metric, ts,\n        ts_local: d.setZone(ZONE).toISO(),\n        date_local: d.setZone(ZONE).toFormat('yyyy-MM-dd'),\n        source,\n        units: String(p.units || m.units || ''),\n        qty,\n        extra: Object.keys(extra).length ? JSON.stringify(extra) : '',\n        payload_id: r.payload_id,\n        received_at: r.received_at,\n        updated_at: nowLocal,\n      });\n    }\n  }\n\n  for (const w of (Array.isArray(data.workouts) ? data.workouts : [])) {\n    const id = String((w && w.id) || '');\n    if (!id) { errors.push(r.payload_id + ': workout without id'); continue; }\n    const s = parseTs(w.start); const e = parseTs(w.end);\n    const hr = w.heartRate || {};\n    workouts.set(id, {\n      record_type: 'workout',\n      workout_id: id,\n      name: String(w.name || ''),\n      start_at: s ? s.toUTC().toISO() : '',\n      end_at: e ? e.toUTC().toISO() : '',\n      start_local: s ? s.setZone(ZONE).toISO() : '',\n      date_local: s ? s.setZone(ZONE).toFormat('yyyy-MM-dd') : '',\n      duration_min: num(w.duration) === null ? null : Math.round(num(w.duration) / 6) / 10,\n      distance_km: toKm(w.distance),\n      active_energy_kcal: toKcal(w.activeEnergyBurned),\n      total_energy_kcal: toKcal(w.totalEnergy),\n      avg_hr: qtyOf(hr.avg) !== null ? Math.round(qtyOf(hr.avg) * 10) / 10 : (qtyOf(w.avgHeartRate) !== null ? Math.round(qtyOf(w.avgHeartRate) * 10) / 10 : null),\n      max_hr: qtyOf(hr.max) !== null ? qtyOf(hr.max) : qtyOf(w.maxHeartRate),\n      min_hr: qtyOf(hr.min),\n      source: sourceStr(w.source),\n      location: String(w.location || ''),\n      payload_id: r.payload_id,\n      received_at: r.received_at,\n      body: JSON.stringify(w),\n      updated_at: nowLocal,\n    });\n  }\n}\n\nconst out = [];\nfor (const v of points.values()) out.push({ json: v });\nfor (const v of workouts.values()) out.push({ json: v });\nif (maxReceived) {\n  out.push({ json: {\n    record_type: 'watermark',\n    name: 'health_raw_watermark',\n    value: maxReceived,\n    note: 'rows=' + rows.length + ' skipped=' + skipped + ' points=' + points.size + ' workouts=' + workouts.size + (errors.length ? ' errors=' + errors.slice(0, 5).join('; ') : '') + (ZONE === 'UTC' ? ' timezone_warning=Settings > Timezone is UTC; confirm import kept it' : ''),\n    updated_at: nowLocal,\n  } });\n}\nout.push({ json: { record_type: 'unlock', name: 'health_raw_dedup_lock', updated_at: nowLocal } });\nreturn out;\n"
      },
