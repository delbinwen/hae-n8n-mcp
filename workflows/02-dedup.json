    {
      "parameters": {
        "jsCode": "// Only move the watermark forward. Compares this run's watermark item with the\n// value stored now (re-read after this run's upserts), both as fixed-width UTC stamps.\n// Always returns one item so the loop continues to the unlock item.\nconst UTC_STAMP = \"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\";\nfunction utcStamp(s) {\n  const d = DateTime.fromISO(String(s || ''), { setZone: true });\n  return d.isValid ? d.toUTC().toFormat(UTC_STAMP) : '';\n}\nconst wm = $('Flatten metrics and workouts').all().map(i => i.json).find(j => j && j.record_type === 'watermark') || {};\nconst storedRaw = $input.first() ? String(($input.first().json || {}).value || '') : '';\nconst stored = utcStamp(storedRaw);\nconst next = utcStamp(wm.value);\nconst save = next !== '' && (stored === '' || next > stored);\nreturn [{ json: {\n  save,\n  name: 'health_raw_watermark',\n  value: wm.value || '',\n  stored_value: storedRaw,\n  note: wm.note || '',\n  updated_at: wm.updated_at || '',\n} }];\n"
      },
      "id": "66545bb8-a932-4d98-8b25-c3909894006c",
      "name": "Compare with stored watermark",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
