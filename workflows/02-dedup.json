      "id": "d8738307-4f27-4542-b901-e06bdd9932d8",
      "name": "Read new health_raw rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        512,
        -32
      ],
      "executeOnce": true,
      "alwaysOutputData": true
